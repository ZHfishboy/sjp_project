{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm install && npm install --prefix frontend && npm install --prefix backend",
  "buildCommand": "npm run build --prefix backend && npm run build --prefix frontend",
  "outputDirectory": "frontend/dist",
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/v1/auth/register.ts": {
      "maxDuration": 10
    },
    "api/v1/auth/login.ts": {
      "maxDuration": 10
    },
    "api/v1/auth/refresh.ts": {
      "maxDuration": 10
    },
    "api/v1/captcha/image.ts": {
      "maxDuration": 10
    },
    "api/v1/captcha/verify.ts": {
      "maxDuration": 10
    },
    "api/v1/vip/status.ts": {
      "maxDuration": 10
    },
    "api/v1/vip/order.ts": {
      "maxDuration": 10
    },
    "api/v1/user/profile.ts": {
      "maxDuration": 10
    },
    "api/v1/gift/first-purchase.ts": {
      "maxDuration": 10
    },
    "api/v1/gift/first-purchase/shown.ts": {
      "maxDuration": 10
    },
    "api/v1/gift/first-purchase/dismiss.ts": {
      "maxDuration": 10
    },
    "api/v1/invite/my-code.ts": {
      "maxDuration": 10
    },
    "api/v1/exchange/currencies.ts": {
      "maxDuration": 10
    },
    "api/v1/exchange/convert.ts": {
      "maxDuration": 10
    },
    "api/v1/unit/categories.ts": {
      "maxDuration": 10
    },
    "api/v1/unit/convert.ts": {
      "maxDuration": 10
    },
    "api/v1/calc/evaluate.ts": {
      "maxDuration": 10
    },
    "api/v1/calc/history.ts": {
      "maxDuration": 10
    },
    "api/v1/splash-popup/list.ts": {
      "maxDuration": 10
    },
    "api/v1/splash-popup/log.ts": {
      "maxDuration": 10
    },
    "api/v1/exit-intent/copy.ts": {
      "maxDuration": 10
    },
    "api/v1/exit-intent/log.ts": {
      "maxDuration": 10
    },
    "api/v1/[...all].ts": {
      "maxDuration": 10
    }
  }
}
