{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm install && npm install --prefix frontend && npm install --prefix backend",
  "buildCommand": "npm run build --prefix backend && npm run build --prefix frontend",
  "outputDirectory": "frontend/dist",
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/v1/[...all].ts": {
      "maxDuration": 10
    },
    "api/v1/auth/[...all].ts": {
      "maxDuration": 10
    },
    "api/v1/captcha/[...all].ts": {
      "maxDuration": 10
    },
    "api/v1/calc/[...all].ts": {
      "maxDuration": 10
    },
    "api/v1/exchange/[...all].ts": {
      "maxDuration": 10
    },
    "api/v1/unit/[...all].ts": {
      "maxDuration": 10
    },
    "api/v1/user/[...all].ts": {
      "maxDuration": 10
    },
    "api/v1/vip/[...all].ts": {
      "maxDuration": 10
    },
    "api/v1/gift/[...all].ts": {
      "maxDuration": 10
    },
    "api/v1/invite/[...all].ts": {
      "maxDuration": 10
    },
    "api/v1/exit-intent/[...all].ts": {
      "maxDuration": 10
    },
    "api/v1/splash-popup/[...all].ts": {
      "maxDuration": 10
    }
  }
}
