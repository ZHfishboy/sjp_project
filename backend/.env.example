# ── Server ──
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# ── SQLite (zero-install, file-based) ──
DB_PATH=./data/calcmaster.db

# ── Redis (optional — captcha/rate-limit will use in-memory fallback if unavailable) ──
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ── JWT ──
JWT_SECRET=change_this_to_a_random_64_char_string
JWT_REFRESH_SECRET=change_this_to_another_random_64_char_string
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# ── SMS / Email (placeholder) ──
SMS_API_KEY=
SMS_API_SECRET=
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USER=noreply@calcmaster.com
EMAIL_PASS=

# ── Exchange Rate API ──
EXCHANGE_RATE_API_KEY=
EXCHANGE_RATE_API_URL=https://api.exchangerate-api.com/v4/latest

# ── Payment (placeholder) ──
WECHAT_PAY_APP_ID=
WECHAT_PAY_API_KEY=
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=

# ── Captcha ──
CAPTCHA_EXPIRE_SECONDS=120
CAPTCHA_MAX_PER_IP_PER_MINUTE=10

# ── Rate Limits ──
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# ── Speed Tier Delays (ms) ──
SPEED_TIER_3_DELAY_MS=3000
SPEED_TIER_2_DELAY_MS=200
SPEED_TIER_1_DELAY_MS=0
